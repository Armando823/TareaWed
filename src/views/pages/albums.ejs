<section class="mb-4">
  <h2 class="mb-3">Álbumes</h2>

  <% if (albums.length === 0) { %>
    <div class="alert alert-info">No hay álbumes disponibles.</div>
  <% } %>

  <% albums.forEach(album => { %>
    <div class="card mb-4 shadow-sm album-card">

      <div class="card-body">
        <h5><%= album.title %></h5>
        <p class="text-muted"><%= album.description %></p>

        <!-- Imagen -->
        <% if (album.images && album.images.length > 0) { %>
          <img src="<%= album.images[0] %>" class="img-fluid rounded mb-3">
        <% } %>

        <!-- Stats -->
        <div class="d-flex justify-content-between text-muted small mb-2">
          <span>👍 <span class="album-like-count"><%= album.likes %></span></span>
          <span>💬 <span class="album-comment-count"><%= album.comments %></span></span>
          <span>🔗 <span class="album-share-count"><%= album.shares %></span></span>
        </div>

        <!-- Botones -->
        <div class="d-flex gap-2">
          <button class="btn btn-light btn-like" data-album-id="<%= album.id %>">👍 Me gusta</button>
          <button class="btn btn-light btn-comment" data-album-id="<%= album.id %>">💬 Comentar</button>
          <button class="btn btn-light btn-share" data-album-id="<%= album.id %>">🔗 Compartir</button>
        </div>

      </div>
    </div>
  <% }) %>
</section>