<section class="mb-4">
  <h2 class="mb-3">Amigos</h2>

  <!-- BOTÓN CARGAR -->
  <button id="loadContactsButton" class="btn btn-primary mb-3">
    Cargar contactos
  </button>

  <!-- FORMULARIO -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <h5>Agregar amigo</h5>

      <div class="row g-2">
        <div class="col-md-4">
          <input id="newContactName" class="form-control" placeholder="Nombre">
        </div>
        <div class="col-md-4">
          <input id="newContactEmail" class="form-control" placeholder="Email">
        </div>
        <div class="col-md-4">
          <input id="newContactPhone" class="form-control" placeholder="Teléfono">
        </div>
      </div>

      <button id="addContactButton" class="btn btn-success mt-2">
        Agregar
      </button>
    </div>
  </div>

  <!-- TABLA -->
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Favorito</th>
          </tr>
        </thead>
        <tbody id="contactsBody">
          <tr>
            <td colspan="4" class="text-center text-muted">
              Carga los contactos
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>