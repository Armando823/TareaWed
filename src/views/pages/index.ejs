<section class="mb-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <h4 class="mb-3">Bienvenido, <%= profile.name %> 👋</h4>
      <p class="text-muted">
        Este es tu panel principal. Aquí puedes navegar entre tus álbumes, amigos y favoritos.
      </p>

      <div class="d-flex align-items-center gap-3 mt-4">
        <img src="<%= profile.avatar %>" class="rounded-circle" width="60">
        <div>
          <strong>Actividad reciente</strong>
          <p class="text-muted small mb-0">Revisa tus últimos movimientos en la app</p>
        </div>
      </div>
    </div>
  </div>
</section>