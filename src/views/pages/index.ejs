<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mi Aplicación</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-3d6NcXG4t+jSfhAveYCCiUYQOHHzGN/n8tY2gcOJG/IIc/3e2ogM9M7PZtYJ3onl" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../components/navbar') %>
    <% const section = activeSection || 'inicio'; %>
    <div class="container mt-4">
      <div class="row gx-4">
        <aside class="col-lg-3 d-none d-lg-block">
          <div class="card mb-4 shadow-sm sidebar-card">
            <div class="card-body text-center">
              <img src="<%= profile.avatar %>" alt="Avatar" class="avatar-img shadow mb-3" />
              <h5 class="card-title mb-1"><%= profile.name %></h5>
              <p class="text-muted small"><%= profile.description %></p>
            </div>
          </div>
          <div class="card shadow-sm sidebar-card">
            <div class="card-body">
              <h6 class="card-title">Guardados</h6>
              <% if (favorites.length === 0) { %>
                <p class="text-muted small mb-0">No tienes elementos guardados todavía.</p>
              <% } else { %>
                <ul class="list-group list-group-flush">
                  <% favorites.slice(0, 5).forEach((favorite) => { %>
                    <li class="list-group-item py-2"><%= favorite.title %></li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>
        </aside>

        <main class="col-lg-6">
          <% if (section === 'inicio') { %>
            <section id="inicio" class="mb-4">
              <div class="card shadow-sm feed-card">
                <div class="card-body">
                  <h4 class="card-title mb-3">Bienvenido, <%= profile.name %>!</h4>
                  <p class="text-muted">Este es tu inicio. Usa la barra superior para navegar entre Perfil, Álbumes, Amigos y Guardados.</p>
                  <div class="d-flex align-items-center gap-3 mt-4">
                    <img src="<%= profile.avatar %>" alt="Avatar" class="avatar-sm" />
                    <div>
                      <p class="mb-1"><strong>Tu actividad reciente</strong></p>
                      <p class="text-muted small">Revisa tus álbumes y amigos o guarda tus favoritos.</p>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          <% } else if (section === 'perfil') { %>
            <section id="perfil" class="mb-4">
              <div class="card shadow-sm feed-card">
                <div class="card-body">
                  <h4 class="card-title mb-3">Perfil</h4>
                  <div class="d-flex align-items-center gap-3 mb-3">
                    <img src="<%= profile.avatar %>" alt="Avatar" class="avatar-img shadow" />
                    <div>
                      <h5><%= profile.name %></h5>
                      <p class="text-muted"><%= profile.description %></p>
                    </div>
                  </div>
                  <p>Aquí puedes ver la información de tu perfil y destacar tus datos principales. Este módulo sigue cumpliendo tu tarea de Descripción y Foto.</p>
                </div>
              </div>
            </section>
          <% } else if (section === 'albums') { %>
            <section id="albums" class="mb-4">
              <h2 class="section-title">Álbumes</h2>
              <% albums.forEach((album) => { %>
                <article class="card mb-4 shadow-sm feed-card album-card">
                  <div class="card-header d-flex align-items-center justify-content-between album-header">
                    <div class="d-flex align-items-center gap-3">
                      <img src="<%= profile.avatar %>" alt="Avatar" class="avatar-sm" />
                      <div>
                        <h6 class="mb-0"><%= profile.name %></h6>
                        <small class="text-muted">Hace unos minutos</small>
                      </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-light album-header-menu"><i class="bi bi-three-dots"></i></button>
                  </div>
                  <div class="card-body">
                    <h5 class="card-title mb-2"><%= album.title %></h5>
                    <p class="text-muted mb-4"><%= album.description %></p>
                    <div class="row g-3 mb-4 album-images-row">
                      <% album.images.forEach((img, imgIndex) => { %>
                        <div class="col-12 col-md-6">
                          <div class="card album-image-card overflow-hidden border">
                            <img src="<%= img %>" alt="Foto" class="img-fluid" />
                          </div>
                        </div>
                      <% }); %>
                    </div>
                    <div class="album-stat-bar d-flex flex-wrap justify-content-between align-items-center text-muted small mb-3">
                      <div><i class="bi bi-hand-thumbs-up-fill text-primary me-1"></i><span class="album-like-count"><%= album.likes %></span></div>
                      <div><i class="bi bi-chat-left-text me-1"></i><span class="album-comment-count"><%= album.comments %></span> comentarios</div>
                      <div><i class="bi bi-share-fill me-1"></i><span class="album-share-count"><%= album.shares %></span> compartidos</div>
                    </div>
                    <div class="album-action-row d-flex justify-content-between gap-2 border-top pt-3 mb-3">
                      <button type="button" class="btn btn-light flex-fill btn-like" data-album-id="<%= album.id %>"><i class="bi bi-hand-thumbs-up"></i> Me gusta</button>
                      <button type="button" class="btn btn-light flex-fill btn-comment" data-album-id="<%= album.id %>"><i class="bi bi-chat"></i> Comentar</button>
                      <button type="button" class="btn btn-light flex-fill btn-share" data-album-id="<%= album.id %>"><i class="bi bi-share"></i> Compartir</button>
                    </div>
                    <div class="album-comment-panel rounded-3 border p-3 bg-light">
                      <div class="d-flex align-items-start gap-3 mb-3">
                        <img src="<%= profile.avatar %>" alt="Avatar" class="avatar-sm" />
                        <textarea class="form-control form-control-sm" rows="2" placeholder="Escribe un comentario..." data-album-id="<%= album.id %>" onkeypress="if(event.key==='Enter'){event.preventDefault(); submitAlbumComment(this);} "></textarea>
                      </div>
                      <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-primary btn-sm" onclick="submitAlbumComment(this.closest('.album-comment-panel').querySelector('textarea'))">Publicar</button>
                      </div>
                      <div class="album-comment-list mt-3"></div>
                    </div>
                  </div>
                </article>
              <% }); %>
            </section>
          <% } else if (section === 'contactos') { %>
            <section id="contactos" class="mb-4">
              <div class="d-flex justify-content-between align-items-start gap-3 mb-4 flex-column flex-md-row">
                <div>
                  <h2 class="section-title mb-0">Amigos</h2>
                  <p class="text-muted small mt-1">Gestiona tus contactos y agrégalos a favoritos</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                  <button id="loadContactsButton" class="btn btn-primary btn-sm" title="Cargar lista de amigos">
                    <i class="bi bi-download me-2"></i>Cargar amigos
                  </button>
                </div>
              </div>

              <div class="card mb-4 shadow-sm contact-form-card">
                <div class="card-body">
                  <div class="d-flex align-items-start justify-content-between gap-3 flex-column flex-md-row mb-3">
                    <div>
                      <h5 class="mb-1">Agregar nuevo amigo</h5>
                      <p class="text-muted small mb-0">Completa nombre, Gmail y teléfono para guardar el contacto en tu lista.</p>
                    </div>
                  </div>
                  <form id="contactForm" class="row g-3 align-items-end">
                    <div class="col-12 col-md-3">
                      <label for="newContactName" class="form-label small text-muted">Nombre</label>
                      <input id="newContactName" name="name" type="text" class="form-control form-control-sm" placeholder="Ana Ruiz" />
                    </div>
                    <div class="col-12 col-md-3">
                      <label for="newContactEmail" class="form-label small text-muted">Gmail</label>
                      <input id="newContactEmail" name="email" type="email" class="form-control form-control-sm" placeholder="ana@gmail.com" />
                    </div>
                    <div class="col-12 col-md-3">
                      <label for="newContactPhone" class="form-label small text-muted">Teléfono</label>
                      <input id="newContactPhone" name="phone" type="tel" class="form-control form-control-sm" placeholder="555-1234" />
                    </div>
                    <div class="col-12 col-md-3 d-grid">
                      <button id="addContactButton" class="btn btn-success btn-sm" type="button" title="Agregar amigo">
                        <i class="bi bi-person-plus-fill me-1"></i>Agregar amigo
                      </button>
                    </div>
                  </form>
                </div>
              </div>

              <div class="card shadow-sm">
                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-borderless table-hover align-middle mb-0 contact-table">
                      <thead class="table-light">
                        <tr>
                          <th class="text-uppercase text-muted small fw-600"><i class="bi bi-person-circle me-2"></i>Nombre</th>
                          <th class="text-uppercase text-muted small fw-600"><i class="bi bi-telephone me-2"></i>Teléfono</th>
                          <th class="text-uppercase text-muted small fw-600"><i class="bi bi-envelope me-2"></i>Email</th>
                          <th class="text-uppercase text-muted small fw-600 text-center"><i class="bi bi-star me-2"></i>Favorito</th>
                        </tr>
                      </thead>
                      <tbody id="contactsBody">
                        <tr>
                          <td colspan="4" class="text-center py-5">
                            <p class="text-muted mb-2"><i class="bi bi-info-circle me-2"></i>Haz clic en el botón para cargar tus amigos</p>
                            <small class="text-secondary">Se cargarán mediante AJAX sin recargar la página</small>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </section>
          <% } else if (section === 'favoritos') { %>
            <section id="favoritos" class="mb-4">
              <h2 class="section-title">Guardados</h2>
              <div id="favoritesList" class="row gy-3">
                <% if (favorites.length === 0) { %>
                  <div class="col-12">
                    <div class="alert alert-info">No hay favoritos aún. Agrega álbumes o contactos para verlos aquí.</div>
                  </div>
                <% } else { %>
                  <% favorites.forEach((favorite) => { %>
                    <div class="col-md-6">
                      <div class="card shadow-sm">
                        <% if (favorite.image) { %>
                          <img src="<%= favorite.image %>" class="card-img-top" alt="<%= favorite.title %>" />
                        <% } %>
                        <div class="card-body">
                          <h5 class="card-title"><%= favorite.title %></h5>
                          <p class="card-text"><%= favorite.subtitle %></p>
                          <span class="badge bg-warning text-dark favorite-badge"><%= favorite.type %></span>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </section>
          <% } %>
        </main>

        <aside class="col-lg-3 d-none d-lg-block">
          <div class="card mb-4 shadow-sm sidebar-card">
            <div class="card-body">
              <h6 class="card-title">Perfil</h6>
              <p class="mb-2"><strong><%= profile.name %></strong></p>
              <p class="text-muted small"><%= profile.description %></p>
              <a href="/perfil" class="btn btn-primary btn-sm w-100">Ver perfil</a>
            </div>
          </div>

          <div class="card shadow-sm sidebar-card">
            <div class="card-body">
              <h6 class="card-title">Guardados</h6>
              <% if (favorites.length === 0) { %>
                <p class="text-muted small">No hay favoritos aún.</p>
              <% } else { %>
                <ul class="list-group list-group-flush">
                  <% favorites.slice(0, 5).forEach((favorite) => { %>
                    <li class="list-group-item py-2"><%= favorite.title %></li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <script>
      window.initialFavorites = JSON.parse('<%- JSON.stringify(favorites) %>');
    </script>
    <script src="/js/ajax-handler.js" defer></script>
    <script src="/js/reactions.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-KyZXEAg3QhqLMpG8r+8jhAXgGE2HC+eYrZmK5qFv6t1w7N0gJxKf03fD9JqFg6Xx" crossorigin="anonymous"></script>

    <!-- Toast container for notifications -->
    <div class="toast-container"></div>
  </body>
</html>
